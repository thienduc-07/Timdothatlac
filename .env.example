# Không yêu cầu API key cho MVP
# File này chỉ chứa các biến môi trường tùy chọn

# Thiết bị xử lý: cpu hoặc cuda (nếu có GPU NVIDIA)
DEVICE=cpu

# Mức log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# CẤU HÌNH TELEGRAM BOT CẢNH BÁO ĐỒ BỎ QUÊN
# ──────────────────────────────────────────────
# Token lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_placeholder

# Numeric Chat ID của bạn (chạy `python scripts/get_telegram_chat_id.py` để lấy)
TELEGRAM_CHAT_ID=123456789

# Bật/tắt gửi cảnh báo qua Telegram (true / false)
TELEGRAM_ALERTS_ENABLED=true

# Khoảng thời gian chống spam cùng một ghế/vật thể (giây)
TELEGRAM_ALERT_COOLDOWN_SECONDS=60.0
